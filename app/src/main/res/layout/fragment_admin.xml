<?xml version="1.0" encoding="utf-8"?>
        <ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/tabProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- Admin Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TechFix.ShadowCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Administrator Profile"
                            style="@style/Widget.TechFix.SectionTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="Name: TechFix Admin Staff"
                            android:textColor="@color/navy_900"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Email: staff@techfix.lk"
                            android:textColor="@color/muted_text"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Role: Head Workshop Administrator"
                            android:textColor="@color/techfix_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/staffProfileLogoutButton"
                            style="@style/Widget.TechFix.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_16"
                            android:text="Log Out of Staff Workspace"
                            android:textColor="@color/error" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Customer Accounts Directory Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="Registered Customer Directory"
                    style="@style/Widget.TechFix.SectionTitle" />

                <!-- Customer Search Input -->
                <EditText
                    android:id="@+id/searchCustomersInput"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="ðŸ” Search customer by name, email, or phone..."
                    android:inputType="text"
                    android:maxLines="1" />

                <!-- Empty Customers Container -->
                <LinearLayout
                    android:id="@+id/emptyCustomersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16" android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_account"
                        app:tint="@color/muted_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="No customers registered yet"
                        android:textColor="@color/navy_900"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Customers RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/customersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_8"
                    android:nestedScrollingEnabled="false" />

                <!-- System & Database Controls Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TechFix.ShadowCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_24">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Diagnostics &amp; Maintenance"
                            style="@style/Widget.TechFix.SectionTitle" />

                        <TextView
                            android:id="@+id/dbDiagnosticsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="â€¢ Primary Branches: Colombo, Galle\nâ€¢ SQLite DB: v5 active (techfix.db)\nâ€¢ Cloud Sync: Firebase Auth &amp; Firestore enabled"
                            android:textColor="@color/muted_text"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnReseedDemoData"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="Reset &amp; Reseed Demo Database"
                            android:textColor="@color/warning"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
