<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabCatalog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloud"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_16">

        <!-- SECTION 1: SERVICES CATALOG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Repair Services &amp; Pricing"
                style="@style/Widget.TechFix.SectionTitle" />

            <Spinner
                android:id="@+id/catalogBranchSpinner"
                style="@style/Widget.TechFix.Spinner"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="140dp" />
        </LinearLayout>

        <!-- Services RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/servicesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="8dp" />

        <!-- Add New Service Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TechFix.ShadowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publish New Repair Service"
                    style="@style/Widget.TechFix.SectionTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Make this repair available for customers to book in store."
                    android:textColor="@color/muted_text"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/newServiceName"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Service Name (e.g. Camera Lens Fix)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/newServiceCategory"
                        style="@style/Widget.TechFix.Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Category (e.g. Mobile phone)" />

                    <Spinner
                        android:id="@+id/newServiceBranchSpinner"
                        style="@style/Widget.TechFix.Spinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <EditText
                    android:id="@+id/newServiceRequiredPart"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Required Part (optional e.g. Phone display)" />

                <EditText
                    android:id="@+id/newServicePrice"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Standard Price in LKR (e.g. 7500)"
                    android:inputType="numberDecimal" />

                <Button
                    android:id="@+id/addServiceButton"
                    style="@style/Widget.TechFix.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Publish Service to Store" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: TECHNICIANS ROSTER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Technicians &amp; Duty Roster"
            style="@style/Widget.TechFix.SectionTitle" />

        <!-- Technicians RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/techniciansList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="8dp" />

        <!-- Register New Technician Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TechFix.ShadowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register New Technician"
                    style="@style/Widget.TechFix.SectionTitle" />

                <EditText
                    android:id="@+id/newTechName"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Technician Full Name (e.g. Ravindu Perera)" />

                <EditText
                    android:id="@+id/newTechBranch"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Branch (Colombo branch / Galle branch)" />

                <EditText
                    android:id="@+id/newTechSkill"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Skill (Mobile phone / Laptop / computer)" />

                <Button
                    android:id="@+id/addTechButton"
                    style="@style/Widget.TechFix.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Register Technician" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: SHOWCASE PHOTO PUBLISHER -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TechFix.ShadowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sample Repair Showcase"
                    style="@style/Widget.TechFix.SectionTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Publish before &amp; after repair photos to customer explore gallery."
                    android:textAppearance="@style/TextAppearance.TechFix.Body" />

                <EditText
                    android:id="@+id/sampleTitleInput"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Showcase Title (e.g. MacBook Liquid Damage Recovered)" />

                <Button
                    android:id="@+id/addSampleButton"
                    style="@style/Widget.TechFix.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Attach Photo &amp; Publish Showcase" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
