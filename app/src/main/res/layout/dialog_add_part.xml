<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add / Restock Workshop Part"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter the spare component details and initial inventory quantity."
        android:textColor="@color/muted_text"
        android:textSize="14sp" />

    <!-- Part Name Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Part Name"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/dialogPartNameInput"
        style="@style/Widget.TechFix.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="Part Name (e.g. iPhone 14 Display)"
        android:inputType="text"
        android:maxLines="1" />

    <!-- Branch & Quantity Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- Branch Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branch"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/dialogPartBranchSpinner"
                style="@style/Widget.TechFix.Spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Quantity Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dialogPartQtyInput"
                style="@style/Widget.TechFix.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Qty"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
