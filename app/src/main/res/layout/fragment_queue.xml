<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabQueue"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloud"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_16">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TechFix.ShadowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/searchQueueInput"
                    style="@style/Widget.TechFix.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search Docket #, Customer, Device, or Phone…"
                    android:inputType="text"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_queue"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Sort Order:"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sortQueueSpinner"
                        style="@style/Widget.TechFix.Spinner"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    style="@style/Widget.TechFix.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filter_pill_selected"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="ALL DOCKETS"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/chipFilterActive"
                    style="@style/Widget.TechFix.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="ACTIVE"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/chipFilterReceived"
                    style="@style/Widget.TechFix.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="RECEIVED"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/chipFilterRepairing"
                    style="@style/Widget.TechFix.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="IN REPAIR"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/chipFilterReady"
                    style="@style/Widget.TechFix.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="READY FOR PICKUP"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/chipFilterCompleted"
                    style="@style/Widget.TechFix.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="COMPLETED"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/chipFilterUnpaid"
                    style="@style/Widget.TechFix.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="UNPAID"
                    android:textColor="@color/ink" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/queueStatsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Repair Dockets"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/queueStatsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Active Repairs"
                android:textColor="@color/muted_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyQueueContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_32"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_queue"
                app:tint="@color/muted_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No dockets match this filter"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="All repairs are either finished or filtered out."
                android:textColor="@color/muted_text"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appointmentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TechFix.ShadowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Widget.TechFix.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Stage Update" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/appointmentIdInput"
                        style="@style/Widget.TechFix.Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Docket ID #"
                        android:inputType="number" />

                    <Spinner
                        android:id="@+id/statusSpinner"
                        style="@style/Widget.TechFix.Spinner"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="2" />
                </LinearLayout>

                <Button
                    android:id="@+id/updateStatusButton"
                    style="@style/Widget.TechFix.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Apply Stage Update" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
