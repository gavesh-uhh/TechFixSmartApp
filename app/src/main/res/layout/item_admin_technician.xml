<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TechFix.ShadowCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- Top Row: Tech Name, Branch, Specialty -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/techName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nimal Perera"
                    android:textColor="@color/navy_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/techDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📍 Colombo branch · 🛠️ Mobile phone"
                    android:textColor="@color/muted_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Status Indicator Pill -->
            <TextView
                android:id="@+id/techStatusBadge"
                style="@style/Widget.TechFix.Stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🟢 ON DUTY"
                android:textColor="@color/success" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_12"
            android:background="@color/line" />

        <!-- Bottom Controls Row: Active Jobs Load & Duty Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/techActiveJobs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 1 Active Job"
                android:textColor="@color/navy_700"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Toggle Duty Status Button -->
            <Button
                android:id="@+id/btnToggleDuty"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Switch Status"
                android:textColor="@color/navy_700"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <!-- Delete / Remove Tech Button -->
            <Button
                android:id="@+id/btnDeleteTech"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Remove"
                android:textColor="@color/error"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
