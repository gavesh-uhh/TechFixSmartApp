<?xml version="1.0" encoding="utf-8"?>
        <ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/tabInventory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- Inventory Header: Branch Filter & Add Part Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_location"
                            app:tint="@color/muted_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Branch:"
                            android:textColor="@color/muted_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/inventoryBranchSpinner"
                            style="@style/Widget.TechFix.Spinner"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAddPartButton"
                        style="@style/Widget.TechFix.Button.Filled"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/space_12"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="+ Add Part"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Inventory Items Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="6dp"
                    android:text="Spare Parts Stock"
                    style="@style/Widget.TechFix.SectionTitle" />

                <!-- Empty Parts Container -->
                <LinearLayout
                    android:id="@+id/emptyPartsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_24" android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_inventory"
                        app:tint="@color/muted_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="No spare parts registered yet"
                        android:textColor="@color/navy_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Parts RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/partsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_8"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </ScrollView>
