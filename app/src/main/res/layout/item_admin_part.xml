<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TechFix.ShadowCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- Top Row: Part Name & Stock Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/partName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone display"
                    android:textColor="@color/navy_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/partBranch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Colombo branch"
                    android:textColor="@color/muted_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/partStockBadge"
                style="@style/Widget.TechFix.Stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="8 IN STOCK"
                android:textColor="@color/success" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_12"
            android:background="@color/line" />

        <!-- Bottom Controls Row: Quick Quantity Adjusters & Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Adjust:"
                android:textColor="@color/muted_text"
                android:textSize="12sp" />

            <!-- Minus 1 Button -->
            <Button
                android:id="@+id/btnMinusOne"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="âˆ’1"
                android:textColor="@color/navy_700"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <!-- Plus 1 Button -->
            <Button
                android:id="@+id/btnPlusOne"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+1"
                android:textColor="@color/navy_700"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <!-- Plus 5 Restock Button -->
            <Button
                android:id="@+id/btnPlusFive"
                style="@style/Widget.TechFix.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="+5 Restock"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Delete Part Button -->
            <Button
                android:id="@+id/btnDeletePart"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="Delete"
                android:textColor="@color/error"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
