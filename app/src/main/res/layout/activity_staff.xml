<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/staffRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cloud"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/staffHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TechFix Admin"
                android:textColor="@color/navy_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/staffEmailText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="staff@techfix.lk Â· Workshop Control Center"
                android:textColor="@color/muted_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Customer Store Mode Button -->
        <Button
            android:id="@+id/staffHomeStoreButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="@dimen/touch_target"
            android:text="Store"
            android:textColor="@color/techfix_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Log Out Button -->
        <Button
            android:id="@+id/staffLogoutButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="@dimen/touch_target"
            android:text="Log Out"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- Fragment Host for the 5 staff tabs (Overview, Queue, Inventory, Catalog, Admin) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/staffContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Staff Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/staffBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/techfix_blue"
        app:itemTextColor="@color/navy_900"
        app:menu="@menu/bottom_nav_staff" />

</LinearLayout>
